<%- include("partials/header", { title }) %>

<h1>Добавить тренировку</h1>

<% if (error) { %>
  <div class="error-box">
    <%= error %>
  </div>
<% } %>

<form class="card form" method="POST" action="/add">

  <label>
    Дата
    <input
      type="date"
      name="date"
      required
    >
  </label>

  <label>
    Программа
    <input
      type="text"
      name="program"
      placeholder="Push Day"
      required
    >
  </label>

  <label>
    Упражнение
    <input
      type="text"
      name="exercise"
      placeholder="Bench Press"
      required
    >
  </label>

  <div class="form-row">

    <label>
      Вес, кг
      <input
        type="number"
        step="0.1"
        name="weight"
        value="0"
      >
    </label>

    <label>
      Повторения
      <input
        type="number"
        name="reps"
        value="0"
      >
    </label>

    <label>
      Подходы
      <input
        type="number"
        name="sets"
        value="0"
      >
    </label>

    <label>
      Минуты
      <input
        type="number"
        name="duration"
        value="0"
      >
    </label>

  </div>

  <label>
    Заметки
    <textarea
      name="notes"
      rows="4"
    ></textarea>
  </label>

  <label class="checkbox">
    <input
      type="checkbox"
      name="completed"
    >
    Тренировка выполнена
  </label>

  <button
    class="button"
    type="submit"
  >
    Добавить
  </button>

</form>

<%- include("partials/footer") %>